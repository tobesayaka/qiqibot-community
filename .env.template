# ============================================================
# qiqibot 环境变量配置模板
# 复制为 .env.dev（开发）或 .env.prod（生产）后填写
# ============================================================

# ── NoneBot2 核心配置 ──────────────────────────────────────

# 驱动器，fastapi 提供 HTTP 服务，websockets 提供 WS 客户端
DRIVER=~fastapi+~websockets

# 监听地址和端口
HOST=0.0.0.0
PORT=8081

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=DEBUG

# 超级用户 QQ 号列表
SUPERUSERS=["你的QQ号"]

# 命令前缀（已改用自然语言触发，保留即可）
COMMAND_START=["/", ""]
COMMAND_SEP=["."]

# ── OneBot v11 配置（NapCatQQ / go-cqhttp）────────────────

# WebSocket 反向连接地址（NoneBot 主动连 OneBot）
ONEBOT_WS_URLS=["ws://napcat:3001/onebot/v11/ws"]

# OneBot 访问令牌（需与 OneBot 端一致）
ONEBOT_ACCESS_TOKEN=

# API 调用超时（秒）
# ONEBOT_API_TIMEOUT=60

# ── 全局配置 ────────────────────────────────────────────────

# 全局字体路径（所有渲染插件共用）
QIQIBOT_FONT=assets/fonts/NotoSansSC.ttf

# ── 视频下载插件 ────────────────────────────────────────────

# 下载代理（留空则不使用代理）
VIDEO_PROXY=

# 从哪个浏览器读取 cookies（用于需要登录的平台）
# 可选：chrome / firefox / edge / safari / 留空禁用
VIDEO_COOKIES_BROWSER=chrome

# 视频临时保存目录（下载后自动清理）
VIDEO_SAVE_DIR=downloads

# NapCat HTTP API 地址（用于发送超大视频，绕过 WebSocket 大小限制）
# 需要在 NapCat 中单独开启 HTTP 服务器，端口与 WebSocket 分开
VIDEO_HTTP_API_URL=http://napcat:3002

# NapCat HTTP API 访问令牌（与 ONEBOT_ACCESS_TOKEN 一致）
VIDEO_HTTP_API_TOKEN=

# 超过此大小（MB）的视频走 HTTP API 发送
VIDEO_HTTP_THRESHOLD_MB=20

# ── 问答知识库插件 ──────────────────────────────────────────

# 列表/搜索结果最大条数
QA_LIST_LIMIT=10

# 每条问答最多附带图片数
QA_MAX_IMAGES=5

# ── 示例插件 ────────────────────────────────────────────────

# 是否启用示例插件
DEMO_ENABLED=true

# 是否启用复读功能
DEMO_ECHO=true
