# 复制为 .env 后填写，仅用于 docker-compose 部署

# NapCat QQ 号（docker-compose 启动 NapCat 时需要）
QQ_ACCOUNT=你的QQ号

# NoneBot2
DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=8081
LOG_LEVEL=INFO
SUPERUSERS=["你的QQ号"]
COMMAND_START=["/", ""]
COMMAND_SEP=["."]

# OneBot v11 —— docker 内部网络用 napcat 服务名
ONEBOT_WS_URLS=["ws://napcat:3001/onebot/v11/ws"]
ONEBOT_ACCESS_TOKEN=

# NapCat HTTP API 地址（用于发送超大视频，绕过 WebSocket 大小限制）
# 需要在 NapCat 中单独开启 HTTP 服务器，端口与 WebSocket 分开
VIDEO_HTTP_API_URL=http://napcat:3002

# NapCat HTTP API 访问令牌（与 ONEBOT_ACCESS_TOKEN 一致）
VIDEO_HTTP_API_TOKEN=

# 超过此大小（MB）的视频走 HTTP API 发送
VIDEO_HTTP_THRESHOLD_MB=20

# 视频下载插件
VIDEO_PROXY=
VIDEO_COOKIES_BROWSER=chrome
VIDEO_SAVE_DIR=downloads

# 问答知识库插件
QA_LIST_LIMIT=10
QA_MAX_IMAGES=5
